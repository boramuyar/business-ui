{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "business-ui",
  "homepage": "https://github.com/boramuyar/business-ui",
  "include": [
    "style/registry.json",
    "hooks/registry.json",
    "primitives/registry.json",
    "shells/registry.json"
  ],
  "items": [
    {
      "name": "design-guide",
      "type": "registry:file",
      "title": "Design Guide",
      "description": "DESIGN.md and the design/ guides: foundations, patterns, shells and the component catalog, for agents building UI.",
      "categories": [
        "design"
      ],
      "files": [
        {
          "path": "DESIGN.md",
          "type": "registry:file",
          "target": "~/DESIGN.md"
        },
        {
          "path": "design/foundations/color.md",
          "type": "registry:file",
          "target": "~/design/foundations/color.md"
        },
        {
          "path": "design/foundations/typography.md",
          "type": "registry:file",
          "target": "~/design/foundations/typography.md"
        },
        {
          "path": "design/foundations/layout.md",
          "type": "registry:file",
          "target": "~/design/foundations/layout.md"
        },
        {
          "path": "design/patterns/selection-controls.md",
          "type": "registry:file",
          "target": "~/design/patterns/selection-controls.md"
        },
        {
          "path": "design/patterns/overlays.md",
          "type": "registry:file",
          "target": "~/design/patterns/overlays.md"
        },
        {
          "path": "design/patterns/feedback.md",
          "type": "registry:file",
          "target": "~/design/patterns/feedback.md"
        },
        {
          "path": "design/shells.md",
          "type": "registry:file",
          "target": "~/design/shells.md"
        },
        {
          "path": "design/components.md",
          "type": "registry:file",
          "target": "~/design/components.md"
        }
      ]
    },
    {
      "name": "design-check",
      "type": "registry:file",
      "title": "Design Check",
      "description": "A script that flags palette colors, arbitrary values, undocumented components and unjustified shells.",
      "categories": [
        "design"
      ],
      "files": [
        {
          "path": "scripts/design-check.mjs",
          "type": "registry:file",
          "target": "~/scripts/design-check.mjs"
        }
      ]
    }
  ]
}
