{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/components/ui/*": ["./*/index.ts"],
      "@/hooks/use-mobile": ["../hooks/use-mobile.ts"],
      "@/lib/utils": ["../utilities/index.ts"]
    }
  },
  "include": [".", "../hooks", "../utilities"],
  "exclude": ["node_modules", "dist"]
}
