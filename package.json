{
  "name": "@boramuyar/business-ui-registry",
  "version": "1.0.0",
  "description": "Public shadcn registry and showcase.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter showcase dev",
    "build": "pnpm --filter showcase build && pnpm registry:build",
    "typecheck": "pnpm -r --if-present typecheck",
    "registry:build": "pnpm style:build && shadcn build registry.json -o showcase/dist/r",
    "registry:validate": "pnpm style:build && shadcn registry validate registry.json",
    "design:build": "node scripts/generate-design-catalog.mjs",
    "design:check": "node scripts/design-check.mjs primitives shells && node scripts/generate-design-catalog.mjs --check",
    "check": "pnpm typecheck && pnpm design:check && pnpm registry:validate && pnpm build",
    "setup:githooks": "git config core.hooksPath .githooks",
    "style:build": "node scripts/generate-style.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "overrides": {
      "dompurify@^3.0.0": "3.4.13",
      "nanoid@^3.0.0": "3.3.18",
      "postcss@^8.0.0": "8.5.26",
      "qs@^6.0.0": "6.16.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2023-26105"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^6.0.2",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
